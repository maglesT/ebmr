      "type": "G-16",
      "version": "1",
      "title": "Verification / witness",
      "plainName": "Second-person check",
      "level": "PHASE",
      "roles": [
        "VERIFICATION"
      ],
      "significant": false,
      "availability": "ALL",
      "badge": null,
