{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ebmr.invalid/validation-kit/bundle/v1",
  "title": "Evidence bundle v1",
  "description": "What the validation-pack generators read (docs/build-plan/phase-7/slice-7-0-interfaces.md section 1). Every array named in the sort table is sorted by its key with no duplicates; parseBundle checks that beside this schema. Only the keywords validate.ts understands may be used here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundleVersion", "edition", "release", "register", "runs", "results", "trace", "inventory", "criticalLimits", "reviews", "openFindings", "analytics", "records", "sbom", "knownIssues"],
  "properties": {
    "bundleVersion": { "const": 1 },
    "edition": { "$ref": "#/$defs/Edition" },
    "release": { "$ref": "#/$defs/Release" },
    "register": { "$ref": "#/$defs/Register" },
    "runs": { "type": "array", "items": { "$ref": "#/$defs/Run" } },
    "results": { "type": "array", "items": { "$ref": "#/$defs/Result" } },
    "trace": { "$ref": "#/$defs/Trace" },
    "inventory": { "$ref": "#/$defs/Inventory" },
    "criticalLimits": { "type": "array", "items": { "$ref": "#/$defs/CriticalLimit" } },
    "reviews": { "type": "array", "items": { "$ref": "#/$defs/Review" } },
    "openFindings": { "type": "array", "items": { "$ref": "#/$defs/OpenFinding" } },
    "analytics": { "$ref": "#/$defs/Analytics" },
    "records": { "type": "array", "items": { "$ref": "#/$defs/PhaseRecord" } },
    "sbom": { "$ref": "#/$defs/Sbom" },
    "knownIssues": { "type": "array", "items": { "$ref": "#/$defs/KnownIssue" } }
  },
  "$defs": {
    "Edition": { "enum": ["tablets", "injectables", "substance"] },
    "Text": { "type": "string", "minLength": 1 },
    "Sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "CommitId": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "UtcTime": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$" },
    "Date": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
    "ControlId": { "type": "string", "pattern": "^[A-Z]{2}-[0-9]{2,3}$" },
    "ControlIds": { "type": "array", "items": { "$ref": "#/$defs/ControlId" } },
    "Texts": { "type": "array", "items": { "$ref": "#/$defs/Text" } },
    "Severity": { "enum": ["critical", "high", "medium", "low"] },
    "Phase": { "type": "integer", "minimum": 0 },
    "Release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "maker", "version", "commit", "commitTime", "schemaRelease"],
      "properties": {
        "product": { "$ref": "#/$defs/Text" },
        "maker": { "$ref": "#/$defs/Text" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
        "commit": { "$ref": "#/$defs/CommitId" },
        "commitTime": { "$ref": "#/$defs/UtcTime" },
        "schemaRelease": { "$ref": "#/$defs/Sha256" }
      }
    },
    "Register": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controls", "requirements"],
      "properties": {
        "controls": { "type": "array", "items": { "$ref": "#/$defs/Control" } },
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/Requirement" } }
      }
    },
    "Control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "editions", "type", "targetPhase", "sources", "behaviour", "catalogTest", "requirementRows", "implementedBy", "clauses", "deferredScope", "expertDecision", "buildStatus", "draft", "class"],
      "properties": {
        "id": { "$ref": "#/$defs/ControlId" },
        "title": { "$ref": "#/$defs/Text" },
        "editions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Edition" } },
        "type": { "type": "array", "minItems": 1, "items": { "enum": ["ENFORCED", "CONFIGURABLE", "DESIGN_CHOICE"] } },
        "targetPhase": { "$ref": "#/$defs/Phase" },
        "sources": { "type": "string" },
        "behaviour": { "type": "string" },
        "catalogTest": { "type": "string" },
        "requirementRows": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "implementedBy": { "type": "object", "additionalProperties": { "$ref": "#/$defs/Texts" } },
        "clauses": { "type": "array", "items": { "$ref": "#/$defs/Clause" } },
        "deferredScope": { "type": "array", "items": { "$ref": "#/$defs/DeferredScope" } },
        "expertDecision": { "$ref": "#/$defs/ExpertDecision" },
        "buildStatus": { "enum": ["SPECIFIED", "IMPLEMENTED", "VERIFIED"] },
        "draft": { "type": "boolean" },
        "class": { "enum": ["core", "other"] }
      }
    },
    "Clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clause", "tests"],
      "properties": {
        "clause": { "$ref": "#/$defs/Text" },
        "tests": { "$ref": "#/$defs/Texts" },
        "deferred": { "$ref": "#/$defs/Deferral" }
      }
    },
    "Deferral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "reason"],
      "properties": {
        "phase": { "$ref": "#/$defs/Phase" },
        "reason": { "$ref": "#/$defs/Text" }
      }
    },
    "DeferredScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "phase", "reason"],
      "properties": {
        "scope": { "$ref": "#/$defs/Text" },
        "phase": { "$ref": "#/$defs/Phase" },
        "reason": { "$ref": "#/$defs/Text" }
      }
    },
    "ExpertDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "date", "packVersion"],
      "properties": {
        "status": { "enum": ["PENDING", "FOLLOW", "DONT_FOLLOW", "MODIFY"] },
        "reviewer": { "type": ["string", "null"] },
        "date": { "type": ["string", "null"], "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
        "packVersion": { "$ref": "#/$defs/Text" }
      }
    },
    "Requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "source", "verification", "paraphrase"],
      "properties": {
        "n": { "type": "integer", "minimum": 1 },
        "source": { "$ref": "#/$defs/Text" },
        "verification": { "enum": ["primary", "secondary", "unverified"] },
        "paraphrase": { "$ref": "#/$defs/Text" }
      }
    },
    "Run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "commit", "startedAt", "finishedAt", "reportFile", "reportSha256", "host"],
      "properties": {
        "id": { "$ref": "#/$defs/Text" },
        "kind": { "enum": ["vitest", "golden", "playwright", "load", "drill", "security", "accessibility", "mutation"] },
        "commit": { "$ref": "#/$defs/CommitId" },
        "startedAt": { "$ref": "#/$defs/UtcTime" },
        "finishedAt": { "$ref": "#/$defs/UtcTime" },
        "reportFile": { "$ref": "#/$defs/Text" },
        "reportSha256": { "$ref": "#/$defs/Sha256" },
        "host": { "$ref": "#/$defs/Host" }
      }
    },
    "Host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory", "os", "node", "postgres"],
      "properties": {
        "cpu": { "$ref": "#/$defs/Text" },
        "memory": { "$ref": "#/$defs/Text" },
        "os": { "$ref": "#/$defs/Text" },
        "node": { "$ref": "#/$defs/Text" },
        "postgres": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test", "run", "status", "durationMs", "controls"],
      "properties": {
        "test": { "$ref": "#/$defs/Text" },
        "run": { "$ref": "#/$defs/Text" },
        "status": { "enum": ["passed", "failed", "skipped"] },
        "durationMs": { "type": "number", "minimum": 0 },
        "controls": { "$ref": "#/$defs/ControlIds" },
        "evidence": { "type": "object", "description": "The browser suite's step record, as its report holds it." }
      }
    },
    "Trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "editions", "ok", "controls"],
      "properties": {
        "phase": { "$ref": "#/$defs/Phase" },
        "editions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Edition" } },
        "ok": { "type": "boolean" },
        "controls": { "type": "array", "items": { "$ref": "#/$defs/TraceControl" } }
      }
    },
    "TraceControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control", "passing", "clauses"],
      "properties": {
        "control": { "$ref": "#/$defs/ControlId" },
        "passing": { "$ref": "#/$defs/Texts" },
        "clauses": { "type": "array", "items": { "$ref": "#/$defs/TraceClause" } }
      }
    },
    "TraceClause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clause", "status"],
      "properties": {
        "clause": { "$ref": "#/$defs/Text" },
        "status": { "enum": ["PROVEN", "DEFERRED", "MISSING"] }
      }
    },
    "Inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["migrations", "functions", "triggers", "constraints", "privileges", "roles", "settings", "auditedTables", "permissions", "meanings", "messages", "stateCharts", "blocks", "ruleKeys", "routes"],
      "properties": {
        "migrations": { "type": "array", "items": { "$ref": "#/$defs/InvMigration" } },
        "functions": { "type": "array", "items": { "$ref": "#/$defs/InvFunction" } },
        "triggers": { "type": "array", "items": { "$ref": "#/$defs/InvTrigger" } },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/InvConstraint" } },
        "privileges": { "type": "array", "items": { "$ref": "#/$defs/InvPrivilege" } },
        "roles": { "type": "array", "items": { "$ref": "#/$defs/InvRole" } },
        "settings": { "type": "array", "items": { "$ref": "#/$defs/InvSetting" } },
        "auditedTables": { "type": "array", "items": { "$ref": "#/$defs/InvAuditedTable" } },
        "permissions": { "type": "array", "items": { "$ref": "#/$defs/InvPermission" } },
        "meanings": { "type": "array", "items": { "$ref": "#/$defs/InvMeaning" } },
        "messages": { "type": "array", "items": { "$ref": "#/$defs/InvMessage" } },
        "stateCharts": { "type": "array", "items": { "$ref": "#/$defs/InvStateChart" } },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/InvBlock" } },
        "ruleKeys": { "type": "array", "items": { "$ref": "#/$defs/InvRuleKey" } },
        "routes": { "type": "array", "items": { "$ref": "#/$defs/InvRoute" } }
      }
    },
    "InvMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "name", "sha256"],
      "properties": { "namespace": { "$ref": "#/$defs/Text" }, "name": { "$ref": "#/$defs/Text" }, "sha256": { "$ref": "#/$defs/Sha256" } }
    },
    "InvFunction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "name", "argTypes", "securityDefiner", "owner", "executeRoles"],
      "properties": {
        "schema": { "$ref": "#/$defs/Text" },
        "name": { "$ref": "#/$defs/Text" },
        "argTypes": { "type": "string" },
        "securityDefiner": { "type": "boolean" },
        "owner": { "$ref": "#/$defs/Text" },
        "executeRoles": { "$ref": "#/$defs/Texts" }
      }
    },
    "InvTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table", "name", "enabled", "function"],
      "properties": { "table": { "$ref": "#/$defs/Text" }, "name": { "$ref": "#/$defs/Text" }, "enabled": { "type": "boolean" }, "function": { "$ref": "#/$defs/Text" } }
    },
    "InvConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table", "name", "kind", "definitionSha256"],
      "properties": { "table": { "$ref": "#/$defs/Text" }, "name": { "$ref": "#/$defs/Text" }, "kind": { "$ref": "#/$defs/Text" }, "definitionSha256": { "$ref": "#/$defs/Sha256" } }
    },
    "InvPrivilege": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "object", "privilege"],
      "properties": { "role": { "$ref": "#/$defs/Text" }, "object": { "$ref": "#/$defs/Text" }, "privilege": { "$ref": "#/$defs/Text" } }
    },
    "InvRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "login", "superuser", "createRole", "bypassRls", "inherit", "connectionLimit"],
      "properties": {
        "name": { "$ref": "#/$defs/Text" },
        "login": { "type": "boolean" },
        "superuser": { "type": "boolean" },
        "createRole": { "type": "boolean" },
        "bypassRls": { "type": "boolean" },
        "inherit": { "type": "boolean" },
        "connectionLimit": { "type": "integer", "minimum": -1 }
      }
    },
    "InvSetting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "expected"],
      "properties": { "name": { "$ref": "#/$defs/Text" }, "value": { "type": "string" }, "expected": { "type": ["string", "null"] } }
    },
    "InvAuditedTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table"],
      "properties": { "table": { "$ref": "#/$defs/Text" } }
    },
    "InvPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permission", "roles", "scopeKinds"],
      "properties": { "permission": { "$ref": "#/$defs/Text" }, "roles": { "$ref": "#/$defs/Texts" }, "scopeKinds": { "$ref": "#/$defs/Texts" } }
    },
    "InvMeaning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meaning"],
      "properties": { "meaning": { "$ref": "#/$defs/Text" } }
    },
    "InvMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "text", "sourceFile"],
      "properties": { "code": { "type": "string", "pattern": "^EBMR-[A-Z]+-[0-9]{3,4}$" }, "text": { "$ref": "#/$defs/Text" }, "sourceFile": { "$ref": "#/$defs/Text" } }
    },
    "InvStateChart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machine", "states", "transitions"],
      "properties": {
        "machine": { "$ref": "#/$defs/Text" },
        "states": { "$ref": "#/$defs/Texts" },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/InvTransition" } }
      }
    },
    "InvTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "event", "to"],
      "properties": { "from": { "$ref": "#/$defs/Text" }, "event": { "$ref": "#/$defs/Text" }, "to": { "$ref": "#/$defs/Text" } }
    },
    "InvBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockType", "version", "controls"],
      "properties": { "blockType": { "$ref": "#/$defs/Text" }, "version": { "type": "integer", "minimum": 1 }, "controls": { "$ref": "#/$defs/ControlIds" } }
    },
    "InvRuleKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": { "key": { "$ref": "#/$defs/Text" } }
    },
    "InvRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "route", "method", "permission"],
      "properties": {
        "namespace": { "$ref": "#/$defs/Text" },
        "route": { "$ref": "#/$defs/Text" },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "permission": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "CriticalLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "description", "controls", "boundaryTests"],
      "properties": {
        "key": { "$ref": "#/$defs/Text" },
        "description": { "$ref": "#/$defs/Text" },
        "controls": { "$ref": "#/$defs/ControlIds" },
        "boundaryTests": { "$ref": "#/$defs/Texts" }
      }
    },
    "Review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "date", "scope", "findings"],
      "properties": {
        "id": { "$ref": "#/$defs/Text" },
        "date": { "$ref": "#/$defs/Date" },
        "scope": { "$ref": "#/$defs/Texts" },
        "findings": { "$ref": "#/$defs/FindingCounts" }
      }
    },
    "FindingCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "high", "medium", "low"],
      "properties": {
        "critical": { "$ref": "#/$defs/OpenFixed" },
        "high": { "$ref": "#/$defs/OpenFixed" },
        "medium": { "$ref": "#/$defs/OpenFixed" },
        "low": { "$ref": "#/$defs/OpenFixed" }
      }
    },
    "OpenFixed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open", "fixed"],
      "properties": { "open": { "type": "integer", "minimum": 0 }, "fixed": { "type": "integer", "minimum": 0 } }
    },
    "OpenFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "controls", "summary", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/Text" },
        "severity": { "$ref": "#/$defs/Severity" },
        "controls": { "$ref": "#/$defs/ControlIds" },
        "summary": { "$ref": "#/$defs/Text" },
        "source": { "$ref": "#/$defs/Text" }
      }
    },
    "Analytics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methods"],
      "properties": { "methods": { "type": "array", "items": { "$ref": "#/$defs/AnalyticsMethod" } } }
    },
    "AnalyticsMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "versions", "intendedUse", "changesGmpData"],
      "properties": {
        "id": { "$ref": "#/$defs/Text" },
        "versions": { "$ref": "#/$defs/Texts" },
        "intendedUse": { "$ref": "#/$defs/Text" },
        "changesGmpData": { "type": "boolean" }
      }
    },
    "PhaseRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "file", "sha256", "passed", "summary", "measures"],
      "properties": {
        "kind": { "enum": ["load", "soak", "restore", "upgrade", "migration-dry-run", "security", "accessibility", "mutation", "iq", "oq"] },
        "file": { "$ref": "#/$defs/Text" },
        "sha256": { "$ref": "#/$defs/Sha256" },
        "passed": { "type": "boolean" },
        "summary": { "$ref": "#/$defs/Text" },
        "measures": { "type": "array", "items": { "$ref": "#/$defs/Measure" } }
      }
    },
    "Measure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "unit", "limit"],
      "properties": {
        "name": { "$ref": "#/$defs/Text" },
        "value": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
        "unit": { "type": "string" },
        "limit": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "Sbom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "format"],
      "properties": { "file": { "$ref": "#/$defs/Text" }, "sha256": { "$ref": "#/$defs/Sha256" }, "format": { "const": "CycloneDX 1.5" } }
    },
    "KnownIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "controls", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/Text" },
        "severity": { "$ref": "#/$defs/Severity" },
        "controls": { "$ref": "#/$defs/ControlIds" },
        "text": { "$ref": "#/$defs/Text" }
      }
    }
  }
}
