{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ebmr.local/schema/reviews.schema.json",
  "title": "Reviews and their finding counts (compliance/validation/reviews.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["reviews"],
  "$defs": {
    "count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open", "fixed"],
      "properties": {
        "open": { "type": "integer", "minimum": 0 },
        "fixed": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "properties": {
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "date", "scope", "findings"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9A-Za-z]+([.-][0-9A-Za-z]+)*$" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "findings": {
            "type": "object",
            "additionalProperties": false,
            "required": ["critical", "high", "medium", "low"],
            "properties": {
              "critical": { "$ref": "#/$defs/count" },
              "high": { "$ref": "#/$defs/count" },
              "medium": { "$ref": "#/$defs/count" },
              "low": { "$ref": "#/$defs/count" }
            }
          }
        }
      }
    }
  }
}
