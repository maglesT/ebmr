{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ebmr.local/schema/control-class.schema.json",
  "title": "Control class (compliance/validation/control-class.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["classes"],
  "properties": {
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "basis"],
        "properties": {
          "id": { "type": "string", "pattern": "^(DI|PR|ST|IN)-\\d{2}$" },
          "class": { "enum": ["core", "other"] },
          "basis": { "type": "string", "minLength": 10 }
        }
      }
    }
  }
}
