{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ebmr.local/schema/control.schema.json",
  "title": "Control register entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "part", "group", "editions", "type", "target_phase", "target_phase_source", "requirement_rows", "sources", "behaviour", "catalog_test", "implemented_by", "tests", "expert_decision", "build_status"],
  "properties": {
    "id": { "type": "string", "pattern": "^(DI|PR|ST|IN|AS)-\\d{2}$" },
    "title": { "type": "string", "minLength": 3 },
    "part": { "enum": ["A", "B", "C", "D"] },
    "group": { "type": "string" },
    "editions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["tablets", "injectables", "substance"] } },
    "type": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["ENFORCED", "CONFIGURABLE", "DESIGN_CHOICE"] } },
    "target_phase": { "type": "integer", "minimum": 0, "maximum": 7 },
    "target_phase_source": { "enum": ["outline", "default"] },
    "requirement_rows": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
    "sources": { "type": "string" },
    "behaviour": { "type": "string", "minLength": 10 },
    "jurisdiction": { "type": "string" },
    "catalog_test": { "type": "string" },
    "scope": { "type": "string" },
    "type_detail": { "type": "string" },
    "notes": { "type": "string" },
    "implemented_by": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modules": { "type": "array", "items": { "type": "string" } },
        "blocks": { "type": "array", "items": { "type": "string" } },
        "invariants": { "type": "array", "items": { "type": "string" } },
        "guards": { "type": "array", "items": { "type": "string" } },
        "db_constraints": { "type": "array", "items": { "type": "string" } },
        "rule_keys": { "type": "array", "items": { "type": "string" } },
        "policies": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tests": { "type": "array", "items": { "type": "string" } },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clause"],
        "oneOf": [
          { "properties": { "tests": true }, "required": ["tests"] },
          { "properties": { "deferred": true }, "required": ["deferred"] },
          { "properties": { "not_required": true }, "required": ["not_required"] }
        ],
        "properties": {
          "clause": { "type": "string", "minLength": 1 },
          "tests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "deferred": {
            "type": "object",
            "additionalProperties": false,
            "required": ["phase", "reason"],
            "properties": {
              "phase": { "type": "integer", "minimum": 1, "maximum": 8, "$comment": "8 = open owner question or deployment item after the editions' exit; never used to hide a gap the lead can decide. A phase-8 reason cites a docs/decisions file (tools/register validate.ts)." },
              "reason": { "type": "string", "minLength": 10 }
            }
          },
          "not_required": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decision", "reason"],
            "properties": {
              "decision": { "type": "string", "minLength": 10 },
              "reason": { "type": "string", "minLength": 10 }
            }
          }
        }
      }
    },
    "deferred_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "phase", "reason"],
        "properties": {
          "scope": { "type": "string", "minLength": 10 },
          "phase": { "type": "integer", "minimum": 1, "maximum": 8, "$comment": "8 = open owner question or deployment item after the editions' exit; never used to hide a gap the lead can decide. A phase-8 reason cites a docs/decisions file (tools/register validate.ts)." },
          "reason": { "type": "string", "minLength": 10 }
        }
      }
    },
    "proposed_modify": { "type": "string" },
    "expert_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "pack_version"],
      "properties": {
        "status": { "enum": ["PENDING", "FOLLOW", "DONT_FOLLOW", "MODIFY"] },
        "pack_version": { "type": "string" },
        "reviewer": { "type": "string" },
        "date": { "type": "string" },
        "comment": { "type": "string" }
      }
    },
    "build_status": { "enum": ["SPECIFIED", "IMPLEMENTED", "VERIFIED"] }
  }
}
