{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ebmr.local/schema/critical-limits.schema.json",
  "title": "Critical limits and their boundary tests (compliance/validation/critical-limits.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["limits"],
  "properties": {
    "limits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "description", "controls", "boundaryTests"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "description": { "type": "string", "minLength": 10 },
          "controls": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(DI|PR|ST|IN)-\\d{2}$" } },
          "boundaryTests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
