# postgresql.conf fragment for eBMR database servers (control DI-13; docs/security/security-baseline.md).
# Include it from postgresql.conf (include_if_exists = 'ebmr-tls.conf'). Checked by
# packages/kernel/test/continuity/security-baseline.test.ts.

ssl = on
ssl_cert_file = '/etc/ebmr/tls/server.crt'
ssl_key_file = '/etc/ebmr/tls/server.key'
ssl_ca_file = '/etc/ebmr/tls/client-ca.crt'
ssl_min_protocol_version = 'TLSv1.2'
ssl_prefer_server_ciphers = on

password_encryption = scram-sha-256

# Attribution of administrator sessions (pgaudit forwards to the write-once sink; ADR 0007, 0012).
log_connections = on
log_disconnections = on
shared_preload_libraries = 'pgaudit'
pgaudit.log = 'ddl, role, write'
pgaudit.log_catalog = off

# Continuous archiving for point-in-time restore (docs/operations/ha-and-restore.md).
wal_level = replica
archive_mode = on
archive_timeout = 60
