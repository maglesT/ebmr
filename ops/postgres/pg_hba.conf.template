# pg_hba.conf template for eBMR database servers (control DI-13; build outline 4.4, 4.7;
# docs/security/security-baseline.md). Checked by packages/kernel/test/continuity/security-baseline.test.ts.
#
# Rules: network connections only over TLS (hostssl), SCRAM-SHA-256 passwords or client certificates,
# never trust / password / md5 / ident. Replace the CIDR placeholders with the site's application,
# standby and backup subnets. Rules are read top to bottom; the first match wins.
#
# Every role named below either is created by the kernel migrations (ebmr_app: application;
# ebmr_authn: authentication service; ebmr_listener and ebmr_sandbox_listener: the gateway listener) or is
# provisioned by the installation (IQ), not by a migration:
# provisioned-roles: postgres ebmr_sandbox ebmr_migrate ebmr_backup ebmr_replicator
# The template test checks that no other role name appears (a misspelt role never matches a rule and
# falls through to the final reject).
#
# TYPE      DATABASE                          USER               ADDRESS              METHOD         OPTIONS

# Break-glass superuser access on the host only (two-person, time-boxed, logged by pgaudit; ADR 0012).
local       all                               postgres                                peer

# Anything that is not TLS is rejected explicitly, before any other rule can match.
hostnossl   all                               all                0.0.0.0/0            reject
hostnossl   all                               all                ::/0                 reject

# Application servers (application role; authentication-service role).
hostssl     ebmr_tablets,ebmr_injectables,ebmr_site   ebmr_app,ebmr_authn  10.10.20.0/24   scram-sha-256

# Sandbox and training database: sandbox role only, never a GMP database (DI-05).
hostssl     ebmr_sandbox_tablets,ebmr_sandbox_injectables   ebmr_sandbox   10.10.20.0/24   scram-sha-256

# The gateway listener's own login, on the application servers (kernel 0980): the GMP one to GMP databases, the
# sandbox one to sandbox databases only (DI-05, DI-30).
hostssl     ebmr_tablets,ebmr_injectables,ebmr_site   ebmr_listener        10.10.20.0/24   scram-sha-256
hostssl     ebmr_sandbox_tablets,ebmr_sandbox_injectables   ebmr_sandbox_listener   10.10.20.0/24   scram-sha-256

# The reporting role (kernel 1210): dashboards and an external reader such as the Deviations and CAPA system (ADR 0022)
# read the report views on a GMP database or its replica, from the reader's host only. The connect policy refuses it
# a sandbox database anyway (DI-05).
hostssl     ebmr_tablets,ebmr_injectables     ebmr_report          10.10.60.10/32  scram-sha-256

# Migration pipeline (change-controlled deployments only).
hostssl     ebmr_tablets,ebmr_injectables,ebmr_site   ebmr_migrate         10.10.30.10/32  cert           clientcert=verify-full

# Backup host (pg_dump and base backups, read-only role with pg_read_all_data).
hostssl     ebmr_tablets,ebmr_injectables,ebmr_site   ebmr_backup          10.10.40.10/32  cert           clientcert=verify-full
hostssl     replication                       ebmr_backup        10.10.40.10/32       cert           clientcert=verify-full

# Synchronous standbys.
hostssl     replication                       ebmr_replicator    10.10.50.0/29        cert           clientcert=verify-full

# Everything else is refused.
hostssl     all                               all                0.0.0.0/0            reject
hostssl     all                               all                ::/0                 reject
