{
  "name": "ebmr",
  "private": true,
  "description": "Electronic Batch Manufacturing Record system: Tablets and Injectables editions",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node --import tsx tools/demo/src/cli.ts run --dev",
    "demo:setup": "node --import tsx tools/demo/src/cli.ts setup",
    "demo": "node --import tsx tools/demo/src/cli.ts run",
    "build:web": "pnpm --filter @ebmr/tablets-web build",
    "openapi": "node --import tsx apps/tablets-server/src/cli/openapi.ts .reports/openapi.json",
    "e2e": "flock /tmp/ebmr-e2e.lock pnpm --filter @ebmr/e2e test",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/ui-kit/tsconfig.json && tsc -p apps/tablets-web/tsconfig.json && tsc -p tools/e2e/tsconfig.json",
    "lint": "node --max-old-space-size=8192 node_modules/eslint/bin/eslint.js .",
    "deps:check": "depcruise --config .dependency-cruiser.cjs packages apps tools",
    "test": "vitest run",
    "test:json": "vitest run --reporter=default --reporter=json --outputFile=.reports/vitest.json",
    "register:import": "tsx tools/register/src/cli.ts import",
    "register:validate": "tsx tools/register/src/cli.ts validate",
    "trace": "tsx tools/register/src/cli.ts trace --results .reports/vitest.json --playwright .reports/playwright.json",
    "trace:e2e": "tsx tools/register/src/cli.ts trace --results .reports/vitest.json --playwright .reports/playwright.json --require-playwright",
    "register:sync-tests": "tsx tools/register/src/cli.ts sync-tests --results .reports/vitest.json --playwright .reports/playwright.json",
    "pins:check": "tsx tools/register/src/cli.ts pins",
    "mutation:ts": "stryker run",
    "mutation:sql": "tsx tools/sql-mutation/src/run.ts",
    "ci": "pnpm typecheck && pnpm lint && pnpm deps:check && pnpm pins:check && pnpm register:validate && pnpm build:web && pnpm test:json && pnpm trace"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "happy-dom": "20.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "patchedDependencies": {
      "@stryker-mutator/vitest-runner@10.0.0": "patches/@stryker-mutator__vitest-runner@10.0.0.patch"
    }
  }
}
